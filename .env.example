# Only for the legacy Discord monitor during the migration.
# New app authentication settings live in backend/.env.example.
# Populate fresh credentials locally or in Railway Variables; never in source.
DG_WEBHOOK=
DG_AUTHORIZATION=
DG_APP_SESSION_TOKEN=
DG_APP_TOKEN=
DG_CUSTOMER_GUID=
DG_DEVICE_UNIQUE_ID=
DG_PARTNER_API_TOKEN=
DG_COOKIE=
# Mount a persistent volume before using this path in Railway.
DG_CACHE_FILE=/data/dg-stock-cache.json
