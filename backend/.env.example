NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# For your iPhone, use the HTTPS domain Railway gives the new backend service.
# Discord's registered redirect must equal PUBLIC_BASE_URL + /v1/auth/discord/callback.
PUBLIC_BASE_URL=http://127.0.0.1:3000
APP_CALLBACK_URL=takeoff://auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord numeric user IDs, not usernames. Empty means deny access.
ALLOWED_DISCORD_IDS=
MODERATOR_DISCORD_IDS=

# Leave 0 locally. Use 1 behind Railway's trusted edge to read X-Real-IP.
# Only enable this when traffic must pass through that proxy; see SETUP.md.
TRUST_PROXY_HOPS=0

# Production requires a Railway volume and this exact mounted data directory:
# NODE_ENV=production
# HOST=0.0.0.0
# DATA_DIR=/data
# PUBLIC_BASE_URL=https://YOUR-BACKEND.up.railway.app
# TRUST_PROXY_HOPS=1
